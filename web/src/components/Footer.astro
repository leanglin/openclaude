---
import { SITE } from '../data/site'

const columns = [
  {
    title: '开始使用',
    links: [
      { href: '/docs/', label: '概览' },
      { href: '/docs/installation/', label: '安装' },
      { href: '/docs/quickstart/', label: '快速开始' },
      { href: '/docs/providers/', label: 'Provider' },
    ],
  },
  {
    title: '参考',
    links: [
      { href: '/docs/slash-commands/', label: '斜杠命令' },
      { href: '/docs/cli-reference/', label: 'CLI 参考' },
      { href: '/docs/configuration/', label: '配置' },
      { href: '/docs/keybindings/', label: '快捷键' },
      { href: '/docs/skills/', label: 'Skills' },
    ],
  },
  {
    title: '项目',
    links: [
      { href: SITE.github, label: 'GitHub' },
      { href: SITE.npmUrl, label: 'npm' },
      { href: `${SITE.github}/blob/main/LICENSE`, label: '许可证' },
      { href: `${SITE.github}/issues`, label: '问题反馈' },
    ],
  },
  {
    title: 'gitlawb',
    links: [
      { href: SITE.gitlawb, label: 'gitlawb.com' },
      { href: SITE.gitlawbRepo, label: '仓库镜像' },
      { href: `${SITE.gitlawb}/architecture`, label: '架构' },
      { href: `${SITE.gitlawb}/agents`, label: 'agents' },
    ],
  },
]
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      {columns.map(col => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map(l => (
              <li>
                <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span class="brand">
        <img src="/openclaude.png" alt="" width="18" height="18" />
        <span>openclaude</span>
        <span class="ver">v{SITE.version}</span>
      </span>
      <span class="sep">·</span>
      <span>开源 coding agent，面向 <a href={SITE.gitlawb} rel="noopener">gitlawb</a> 工作流</span>
      <span class="sep">·</span>
      <span>任何环境运行，接入任何模型。</span>
    </div>
  </div>
</footer>
