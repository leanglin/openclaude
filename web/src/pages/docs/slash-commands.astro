---
import DocsLayout from '../../layouts/DocsLayout.astro'
import { commandCategories, commands, commandsByCategory } from '../../data/commands'

const toc = commandCategories.map(c => ({ id: c.id, label: c.label }))
---

<DocsLayout
  title={`openclaude 斜杠命令参考 — ${commands.length}+ 个命令`}
  description={`openclaude 斜杠命令完整参考：/init、/config、/mcp、/review、/compact、/resume 以及 ${commands.length}+ 个命令，按类别分组并附说明。`}
  heading="斜杠命令参考"
  ogImage="/og/commands.png"
  lede={`${commands.length} 个内置斜杠命令，按用途分组。在会话中输入 / 即可自动补全；plugin 和 skill 还可以添加更多命令。`}
  toc={toc}
>
  <p>
    命令在交互式会话中运行，并以 <code>/</code> 开头。启动 binary 时传入的 flags
    请看 <a href="/docs/cli-reference/">CLI 参考</a>。你也可以通过自己的
    <a href="/docs/skills/">Skills</a> 扩展这份列表。
  </p>

  {commandCategories.map(cat => (
    <section>
      <h2 id={cat.id}>{cat.label}</h2>
      <p>{cat.blurb}</p>
      {commandsByCategory(cat.id).map(cmd => (
        <div class="cmd-entry">
          <h3 id={`cmd-${cmd.name}`}>
            <code>/{cmd.name}{cmd.args ? ` ${cmd.args}` : ''}</code>
            <a class="anchor-link" href={`#cmd-${cmd.name}`} aria-label={`链接到 /${cmd.name}`}>#</a>
          </h3>
          <p>{cmd.description}</p>
        </div>
      ))}
    </section>
  ))}
</DocsLayout>
