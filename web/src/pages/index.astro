---
import BaseLayout from '../layouts/BaseLayout.astro'
import CopyCommand from '../components/CopyCommand.astro'
import Terminal from '../components/Terminal.astro'
import { SITE } from '../data/site'

const features = [
  {
    title: '任意模型，一个终端',
    body: 'local Ollama、OpenAI-compatible APIs、Gemini、GitHub Models、gateway 都能接入；一条命令切换 provider，无需重写工作流。',
    href: '/docs/providers/',
    link: 'Provider 设置 →',
  },
  {
    title: '真正的工具，不只是聊天',
    body: 'Bash、文件编辑、grep、glob、MCP server、skills 都进入 agent loop，而不是外挂式拼接。',
    href: '/docs/slash-commands/',
    link: '命令参考 →',
  },
  {
    title: '从第一天就可脚本化',
    body: '非交互式 --print mode 支持 json 和 stream-json 输出，并提供 tool allowlist、预算和 session 控制。',
    href: '/docs/cli-reference/',
    link: 'CLI 参考 →',
  },
  {
    title: '每个仓库独立 profile',
    body: '保存 model、base URL、auth 和运行默认值，让每个 clone 都以同样方式启动。',
    href: '/docs/configuration/',
    link: '配置 →',
  },
  {
    title: '流式执行，而不是批处理黑盒',
    body: '实时看到 agent 思考、调用工具、生成 diff；每一次改动都保持可审查。',
    href: '/docs/quickstart/',
    link: '快速开始 →',
  },
  {
    title: '可持续的会话',
    body: '支持 resume、branch、rewind 对话；也支持后台任务、worktree 隔离和手机远程控制。',
    href: '/docs/slash-commands/#session',
    link: '会话命令 →',
  },
]

const providers = [
  'OpenAI', 'Gemini', 'Ollama', 'GitHub Models', 'OpenRouter', 'DeepSeek',
  'Groq', 'Mistral', 'LM Studio', 'NEAR AI', 'Xiaomi MiMo', 'LiteLLM',
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'openclaude',
    applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux, Windows',
    softwareVersion: SITE.version,
    url: SITE.url,
    downloadUrl: SITE.npmUrl,
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Organization', name: 'GitLawb', url: SITE.gitlawb },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
]
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero grid-bg" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <p class="pill fade-up"><span class="dot" aria-hidden="true"></span>开源 · 面向 gitlawb · 模型中立</p>
      <h1 id="hero-heading" class="text-hero fade-up fade-up-1">
        任意环境运行。<br />任意模型接入。
      </h1>
      <p class="hero-sub fade-up fade-up-2">
        它不是聊天机器人外壳，也不是另一个 IDE 插件。openclaude 是运行在终端中的开源 coding agent，
        可以连接任意模型，并让每次改动都可审查。
      </p>
      <div class="hero-cta fade-up fade-up-3">
        <CopyCommand command={SITE.installCommand} />
        <a class="button button-ghost" href="/docs/quickstart/">阅读文档 →</a>
      </div>
      <p class="hero-foot fade-up fade-up-4">
        支持 OpenAI、Gemini、Codex、Ollama、LM Studio、LiteLLM 和 200+ 模型。
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="demo-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// 实时运行</p>
        <h2 id="demo-heading">看得见的 agent loop。</h2>
      </div>
      <Terminal>
        <span class="ln"><span class="t-prompt">$</span> openclaude</span>
        <span class="ln t-dim">openclaude v{SITE.version} · provider: ollama · model: qwen3-coder</span>
        <span class="ln">&nbsp;</span>
        <span class="ln"><span class="t-prompt">&gt;</span> 给 fetch client 增加带 backoff 的重试</span>
        <span class="ln">&nbsp;</span>
        <span class="ln"><span class="t-info">●</span> Read src/lib/fetchClient.ts</span>
        <span class="ln"><span class="t-info">●</span> Grep "fetchWithTimeout" — 3 matches</span>
        <span class="ln"><span class="t-ok">●</span> Edit src/lib/fetchClient.ts <span class="t-dim">+18 -2</span></span>
        <span class="ln"><span class="t-ok">●</span> Bash bun test fetchClient <span class="t-dim">— 7 pass</span></span>
        <span class="ln">&nbsp;</span>
        <span class="ln t-dim">已添加 exponential backoff（3 次重试，带 jitter）。测试通过。</span>
        <span class="ln cursor">&nbsp;</span>
      </Terminal>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// 特性</p>
        <h2 id="features-heading">为真正交付代码的 agent 构建。</h2>
      </div>
      <div class="card-grid">
        {features.map(f => (
          <a class="card" href={f.href}>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="card-link">{f.link}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="providers-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// Provider</p>
        <h2 id="providers-heading">带上你自己的模型。</h2>
        <p class="lede">
          一个 agent，连接所有后端。用 <code>/provider</code> 配置一次 provider，
          就能在会话中切换模型。
        </p>
      </div>
      <ul class="provider-strip" aria-label="支持的 provider">
        {providers.map(p => <li>{p}</li>)}
      </ul>
      <p class="text-body-dim provider-foot">
        还支持 Bedrock、Vertex、Codex OAuth、Atomic Chat、Opengateway，以及任何
        OpenAI-compatible endpoint。<a href="/docs/providers/">查看所有 provider →</a>
      </p>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="install-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// 安装</p>
        <h2 id="install-heading">一行安装。然后直接写任务。</h2>
      </div>
      <div class="install-grid">
        <CopyCommand command={SITE.installCommand} />
        <ol class="install-steps">
          <li>
            <span class="step-num">01</span>
            <div>
              <strong>安装</strong>
              <p>需要 Node ≥ 20。<a href="/docs/installation/">平台指南 →</a></p>
            </div>
          </li>
          <li>
            <span class="step-num">02</span>
            <div>
              <strong>启动</strong>
              <p>在任意仓库中运行 <code>openclaude</code>。</p>
            </div>
          </li>
          <li>
            <span class="step-num">03</span>
            <div>
              <strong>选择 provider</strong>
              <p>输入 <code>/provider</code> 接入 OpenAI、Ollama、Gemini 或 gateway。</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: calc(var(--nav-h) + clamp(4rem, 12vh, 7rem)) 0 clamp(3.5rem, 9vh, 6rem);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
    position: relative;
  }
  .hero-sub {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.4vw, 1rem);
    line-height: 1.7;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .hero-foot {
    margin: 0.4rem 0 0;
    color: var(--faint);
    font-size: 0.73rem;
    letter-spacing: 0.02em;
  }

  .provider-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .provider-strip li {
    flex: 1 1 auto;
    padding: 0.85rem 1.2rem;
    background: var(--background);
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
    white-space: nowrap;
  }
  .provider-foot { margin-top: 1.25rem; }
  .provider-foot a { color: var(--accent); }

  .install-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 36rem;
  }
  .install-grid :global(.copy-cmd) { width: 100%; justify-content: flex-start; }
  .install-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .install-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .step-num {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    padding-top: 0.18rem;
  }
  .install-steps strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .install-steps p { margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.6; }
  .install-steps a { color: var(--accent); }
</style>
